<!DOCTYPE html><html lang="en" data-theme="light"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> | Davilanco</title><link rel="stylesheet" href="/css/style.css"></head><body>
<header class="header"><div class="container header-inner"><a href="/" class="logo">DAVILANCO</a><nav class="nav-menu" id="navMenu"><a href="/">Home</a><a href="/signup">Signup</a></nav><button class="menu-toggle" onclick="document.getElementById('navMenu').classList.toggle('open')">☰</button><button class="theme-toggle" onclick="toggleTheme()">🌓</button></div></header>
<main class="container main-content">
<h2>Login with Nickname / Email / Phone</h2><% if(error){ %><div class="alert err"><%= error %></div><% } %><% if(query.verified){ %><div class="alert ok">Account created, please login</div><% } %>
<form method="post" class="form-card"><input name="identifier" placeholder="Nickname or Email or Phone" required><input name="password" type="password" placeholder="Password" required><button class="btn btn-primary">Login</button><p>New? <a href="/signup">Create account</a></p></form>
</main><footer class="footer"><p>&copy; 2026 Davilanco</p></footer><script src="/js/main.js"></script></body></html>
