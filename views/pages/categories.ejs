<!DOCTYPE html><html lang="en" data-theme="light"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/style.css"></head><body>
<header class="header"><div class="container header-inner"><a href="/" class="logo">DAVILANCO</a><nav class="nav-menu" id="navMenu"><a href="/">Home</a></nav><button class="theme-toggle" onclick="toggleTheme()">🌓</button></div></header>
<main class="container main-content"><h2>Categories</h2><% categories.forEach(c=>{ %><a href="/?category=<%= c.category %>" class="card" style="display:block;text-decoration:none;color:inherit"><h3><%= c.category %></h3><p><%= c.count %> products</p></a><% }) %></main><footer class="footer"><p>&copy; 2026 Davilanco</p></footer><script src="/js/main.js"></script></body></html>
