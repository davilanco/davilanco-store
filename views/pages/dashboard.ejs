<!DOCTYPE html><html lang="en" data-theme="light"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> | Davilanco</title><link rel="stylesheet" href="/css/style.css"></head><body>
<header class="header"><div class="container header-inner"><a href="/" class="logo">DAVILANCO</a><nav class="nav-menu" id="navMenu"><a href="/">Home</a><a href="/cart">Cart</a><a href="/logout">Logout</a></nav><button class="menu-toggle" onclick="document.getElementById('navMenu').classList.toggle('open')">☰</button><button class="theme-toggle" onclick="toggleTheme()">🌓</button></div></header>
<main class="container main-content">
<h2>Welcome, <%= user.nickname %> - <%= user.role %></h2>
<div class="dash-grid">
<div class="card"><h3>Details <a href="#" onclick="document.getElementById('editForm').classList.toggle('hidden');return false">Edit</a></h3><p><%= user.first_name %> <%= user.last_name %></p><p><%= user.email %></p><form id="editForm" class="hidden form-card" method="post" action="/dashboard/update"><input name="first_name" value="<%= user.first_name %>"><input name="last_name" value="<%= user.last_name %>"><input name="nickname" value="<%= user.nickname %>"><input name="phone" placeholder="Phone"><input name="email" value="<%= user.email %>"><button>Save</button></form></div>
<div class="card"><h3>Change Password</h3><form method="post" action="/dashboard/password" class="form-card"><input name="current" type="password" placeholder="Current password"><input name="newPass" type="password" placeholder="New password"><button>Update</button></form></div>
<div class="card"><h3>Cart</h3><p><%= cartCount %> items</p><a href="/cart" class="btn">View Cart</a></div>
<div class="card"><h3>Notifications</h3><% notifications.forEach(n=>{ %><p><b><%= n.title %></b>: <%= n.body %></p><% }) %></div>
<div class="card"><h3>Messages - All Roles</h3><a href="/dashboard/messages" class="btn">Open Messages</a><% messages.forEach(m=>{ %><p><%= m.message.substring(0,50) %></p><% }) %></div>
<div class="card"><h3>Apply for Seller Account</h3><form method="post" action="/dashboard/apply-seller" class="form-card"><textarea name="products_plan" placeholder="Products you plan to sell" required></textarea><input name="address" placeholder="Your Address" required><input name="id_number" placeholder="ID Number" required><button>Apply</button></form></div>
</div>
<h3>Orders & Tracking (Pending → Approved → Shipping → Delivered)</h3>
<table class="table"><tr><th>ID</th><th>Total</th><th>Status</th><th>Tracking</th><th>Logistics</th></tr><% orders.forEach(o=>{ %><tr><td><%= o.id %></td><td>₦<%= o.total %></td><td><span class="badge <%= o.status %>"><%= o.status %></span></td><td><%= o.tracking_number||'-' %></td><td><%= o.logistics_info||'-' %> ETA: <%= o.expected_arrival||'' %></td></tr><% }) %></table>
</main><footer class="footer"><p>&copy; 2026 Davilanco</p></footer><button id="backTop" class="back-top" onclick="window.scrollTo({top:0,behavior:'smooth'})">↑</button><script src="/js/main.js"></script></body></html>
