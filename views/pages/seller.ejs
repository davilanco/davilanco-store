<!DOCTYPE html><html lang="en" data-theme="light"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/style.css"></head><body>
<header class="header"><div class="container header-inner"><a href="/" class="logo">DAVILANCO SELLER</a><nav class="nav-menu" id="navMenu"><a href="/">Store</a><a href="/dashboard">Dashboard</a></nav><button class="theme-toggle" onclick="toggleTheme()">🌓</button></div></header>
<main class="container main-content">
<h2>Seller Panel</h2><form method="post" action="/seller/product" class="form-card"><h3>Add Product</h3><input name="title" placeholder="Title" required><textarea name="description" placeholder="Description"></textarea><input name="price" type="number" step="0.01" placeholder="Price" required><input name="stock" type="number" placeholder="Stock"><input name="category" placeholder="Category"><input name="image" placeholder="Image URL https://"><button class="btn btn-primary">Add (pending approval)</button></form>
<h3>My Products</h3><table class="table"><tr><th>Title</th><th>Price</th><th>Status</th></tr><% products.forEach(p=>{ %><tr><td><%= p.title %></td><td>₦<%= p.price %></td><td><%= p.status %></td></tr><% }) %></table>
<h3>Orders - Add Tracking</h3><% orders.forEach(o=>{ %><div class="card"><p>Order #<%= o.id %></p><form method="post" action="/seller/tracking/<%= o.id %>" class="form-card"><input name="tracking_number" placeholder="Tracking"><input name="logistics_info" placeholder="Logistics ETA"><button>Ship Order</button></form></div><% }) %>
</main><footer class="footer"><p>&copy; 2026 Davilanco</p></footer><script src="/js/main.js"></script></body></html>
