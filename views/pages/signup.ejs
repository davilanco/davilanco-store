<!DOCTYPE html><html lang="en" data-theme="light"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> | Davilanco</title><link rel="stylesheet" href="/css/style.css"></head><body>
<header class="header"><div class="container header-inner"><a href="/" class="logo">DAVILANCO</a><form action="/" class="search-bar"><input type="search" name="search" placeholder="Search..."><button>Search</button></form><nav class="nav-menu" id="navMenu"><a href="/">Home</a><a href="/login">Login</a><a href="/signup">Signup</a></nav><button class="menu-toggle" onclick="document.getElementById('navMenu').classList.toggle('open')">☰</button><button class="theme-toggle" onclick="toggleTheme()">🌓</button></div></header>
<main class="container main-content">
<h2>Create Customer Account</h2><% if(errors.length){ %><div class="alert err"><% errors.forEach(e=>{ %><p><%= e %></p><% }) %></div><% } %>
<form method="post" class="form-card"><input name="first_name" placeholder="First name" value="<%= form.first_name||'' %>" required><input name="last_name" placeholder="Last name" value="<%= form.last_name||'' %>" required><input name="nickname" placeholder="Nickname (store name if seller later)" value="<%= form.nickname||'' %>" required><input name="phone" placeholder="Phone number" value="<%= form.phone||'' %>" required><input name="email" type="email" placeholder="Email" value="<%= form.email||'' %>" required><input name="password" type="password" placeholder="Password: 8+ chars, uppercase, number, symbol" required><input name="confirm" type="password" placeholder="Confirm password" required><button class="btn btn-primary">Create Account</button></form>
</main><footer class="footer"><p>&copy; 2026 Davilanco</p></footer><script src="/js/main.js"></script></body></html>
