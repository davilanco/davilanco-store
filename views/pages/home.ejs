<!DOCTYPE html><html lang="en" data-theme="light"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> | Davilanco</title><meta name="description" content="Davilanco marketplace"><meta property="og:title" content="<%= title %>"><link rel="stylesheet" href="/css/style.css"></head><body>
<header class="header"><div class="container header-inner"><a href="/" class="logo">DAVILANCO</a><form action="/" method="get" class="search-bar"><input type="search" name="search" placeholder="Search..." value="<%= query.search||'' %>"><button>Search</button></form><nav class="nav-menu" id="navMenu"><a href="/">Home</a><a href="/categories">Categories</a><% if(user){ %><a href="/dashboard">Dashboard (<%= user.nickname %>)</a><% if(user.role==='seller'||user.role==='admin'){ %><a href="/seller">Seller</a><% } %><% if(user.role==='admin'){ %><a href="/admin">Admin</a><% } %><a href="/cart">Cart</a><a href="/logout">Logout</a><% }else{ %><a href="/login">Login</a><a href="/signup">Signup</a><% } %></nav><button class="menu-toggle" onclick="document.getElementById('navMenu').classList.toggle('open')">☰</button><button class="theme-toggle" onclick="toggleTheme()">🌓</button></div></header>
<main class="container main-content">
<h1>Products</h1><div><% categories.forEach(c=>{ if(c){ %><a href="/?category=<%= c %>" class="chip"><%= c %></a><% }}) %></div>
<div class="product-grid"><% products.forEach(p=>{ %><a href="/product/<%= p.id %>" class="product-card"><img src="<%= p.image||'https://via.placeholder.com/300' %>" alt="<%= p.title %>"><h3><%= p.title %></h3><span class="price">₦<%= p.price %></span></a><% }) %></div>
</main><footer class="footer"><p>&copy; 2026 Davilanco</p></footer><button id="backTop" class="back-top" onclick="window.scrollTo({top:0,behavior:'smooth'})">↑</button><script src="/js/main.js"></script></body></html>
