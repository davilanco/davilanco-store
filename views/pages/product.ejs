<!DOCTYPE html><html lang="en" data-theme="light"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> | Davilanco</title><link rel="stylesheet" href="/css/style.css"></head><body>
<header class="header"><div class="container header-inner"><a href="/" class="logo">DAVILANCO</a><nav class="nav-menu" id="navMenu"><a href="/">Home</a><% if(user){ %><a href="/dashboard">Dashboard</a><a href="/cart">Cart</a><a href="/logout">Logout</a><% }else{ %><a href="/login">Login</a><% } %></nav><button class="menu-toggle" onclick="document.getElementById('navMenu').classList.toggle('open')">☰</button><button class="theme-toggle" onclick="toggleTheme()">🌓</button></div></header>
<main class="container main-content">
<div class="product-detail"><img src="<%= product.image||'https://via.placeholder.com/500' %>" alt="<%= product.title %>"><div><h1><%= product.title %></h1><p class="price-lg">₦<%= product.price %></p><p><%= product.description %></p><p>Category: <%= product.category %></p><form action="/cart/add/<%= product.id %>" method="post"><button class="btn btn-primary">Add to Cart</button></form></div></div>
</main><footer class="footer"><p>&copy; 2026 Davilanco</p></footer><script src="/js/main.js"></script></body></html>
