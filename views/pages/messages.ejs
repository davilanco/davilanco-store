<!DOCTYPE html><html lang="en" data-theme="light"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/style.css"></head><body>
<header class="header"><div class="container header-inner"><a href="/" class="logo">DAVILANCO</a><nav class="nav-menu" id="navMenu"><a href="/dashboard">Dashboard</a></nav><button class="theme-toggle" onclick="toggleTheme()">🌓</button></div></header>
<main class="container main-content"><h2>Messages - All Roles can chat</h2><form method="post" class="form-card"><input name="receiver_id" placeholder="Receiver user ID" required><textarea name="message" placeholder="Message" required></textarea><button>Send</button></form><% msgs.forEach(m=>{ %><div class="card"><p>From:<%= m.sender_id %> To:<%= m.receiver_id %></p><p><%= m.message %></p><small><%= m.created_at %></small></div><% }) %></main><footer class="footer"><p>&copy; 2026 Davilanco</p></footer><script src="/js/main.js"></script></body></html>
