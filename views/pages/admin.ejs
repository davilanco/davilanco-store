<!DOCTYPE html><html lang="en" data-theme="light"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> | Davilanco</title><link rel="stylesheet" href="/css/style.css"></head><body>
<header class="header"><div class="container header-inner"><a href="/" class="logo">DAVILANCO ADMIN</a><nav class="nav-menu" id="navMenu"><a href="/">Store</a><a href="/logout">Logout</a></nav><button class="menu-toggle" onclick="document.getElementById('navMenu').classList.toggle('open')">☰</button><button class="theme-toggle" onclick="toggleTheme()">🌓</button></div></header>
<main class="container main-content">
<h2>Admin Panel - Seller Applications</h2><% applications.forEach(a=>{ %><div class="card"><p>User: <%= a.nickname %> (ID:<%= a.user_id %>)</p><p>Plan: <%= a.products_plan %></p><p>Address: <%= a.address %> | ID: <%= a.id_number %> | Status: <%= a.status %></p><form method="post" action="/admin/application/<%= a.id %>" style="display:inline"><input type="hidden" name="action" value="approve"><button class="btn btn-primary">Approve Seller</button></form><form method="post" action="/admin/application/<%= a.id %>" style="display:inline"><input type="hidden" name="action" value="reject"><button>Reject</button></form></div><% }) %>
<h2>All Users - Suspend/Reactivate & Make Seller</h2><table class="table"><tr><th>ID</th><th>Nickname</th><th>Role</th><th>Email</th><th>Actions</th></tr><% users.forEach(u=>{ %><tr><td><%= u.id %></td><td><%= u.nickname %></td><td><%= u.role %></td><td><%= u.email %></td><td><form method="post" action="/admin/promote/<%= u.id %>" style="display:inline"><button>Make Seller</button></form><% if(!u.is_suspended){ %><form method="post" action="/admin/suspend/<%= u.id %>" style="display:inline"><button>Suspend</button></form><% }else{ %><form method="post" action="/admin/reactivate/<%= u.id %>" style="display:inline"><button>Reactivate</button></form><% } %></td></tr><% }) %></table>
<h2>Orders - Update Tracking / Status (pending→approved→shipping→delivered)</h2><% orders.forEach(o=>{ %><div class="card"><p>Order #<%= o.id %> - <%= o.total %> - <%= o.status %> - User:<%= o.user_id %></p><form method="post" action="/admin/order-status/<%= o.id %>" class="form-card"><select name="status"><option value="pending">pending</option><option value="approved">approved</option><option value="shipping">shipping</option><option value="delivered">delivered</option></select><input name="tracking_number" placeholder="Tracking number"><input name="logistics_info" placeholder="Logistics info + ETA"><button>Update</button></form></div><% }) %>
</main><footer class="footer"><p>&copy; 2026 Davilanco Admin</p></footer><script src="/js/main.js"></script></body></html>
