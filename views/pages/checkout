<!DOCTYPE html><html lang="en" data-theme="light"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> | Davilanco</title><link rel="stylesheet" href="/css/style.css"></head><body>
<header class="header"><div class="container header-inner"><a href="/" class="logo">DAVILANCO</a><nav class="nav-menu" id="navMenu"><a href="/">Home</a></nav><button class="theme-toggle" onclick="toggleTheme()">🌓</button></div></header>
<main class="container main-content">
<h2>Checkout</h2><form method="post" class="form-card"><input name="first_name" placeholder="First name" required><input name="last_name" placeholder="Last name" required><input name="phone" placeholder="Phone" required><input name="alt_phone" placeholder="Alternative phone"><input name="neighbor_phone" placeholder="Neighbor's phone"><textarea name="address" placeholder="Full address" required></textarea><input name="town" placeholder="Town" required><input name="lga" placeholder="LGA" required><input name="state" placeholder="State" required><select name="payment_method" required><option value="bank_transfer">Bank Transfer</option><option value="paystack">Paystack</option><option value="flutterwave">Flutterwave</option><option value="paypal">Paypal</option></select><button class="btn btn-primary">Place Order ₦<%= total.toFixed(2) %></button></form>
</main><footer class="footer"><p>&copy; 2026 Davilanco</p></footer><script src="/js/main.js"></script></body></html>
